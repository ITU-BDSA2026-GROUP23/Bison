@page "/"
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2>Public Timeline</h2>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="observationbox">
            <h3>What did you see, @User.Identity.Name?</h3>

            <form method="post" enctype="multipart/form-data">
                <input type="text"
                       name="text"
                       maxlength="2000"
                       required
                       placeholder="Describe your observation..." />

                <input type="file"
                       name="image"
                       accept="image/jpeg,image/png,image/webp" />

                <input type="checkbox"
                       name="license"
                       id="license"
                       required />
                <label for="license">I agree to add a license</label>
                (<a href="/images/license.txt" target="_blank">Read license</a>)

                <button type="submit">Share</button>
            </form>
        </div>
    }

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@obs.Author">@obs.Author</a>
                        </strong>

                        @obs.Text

                        <small>&mdash; @obs.Timestamp |
                        <a href="/images/license.txt" target="_blank">View license</a>
                        </small>
                        
                        @if (obs.ImageData != null && !string.IsNullOrEmpty(obs.ImageContentType))
                        {
                            <img src="data:@obs.ImageContentType;base64,@Convert.ToBase64String(obs.ImageData)"
                                alt="Observation picture"
                                style="max-width: 40px; max-height: 40px;" />
                        }
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
</div>