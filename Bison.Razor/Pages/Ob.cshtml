@page "/ob/{id?}"
@model Bison.Razor.Pages.ObModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var routeId = HttpContext.GetRouteValue("id");
}

<div>
    @if (routeId != null)
    {
        <h2>Observation with ID: @routeId</h2>
    }
    else
    {
        <h2>All Observations</h2>
    }

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@obs.Author">@obs.Author</a>
                        </strong>
                        @obs.Text
                        <small>&mdash; @obs.Timestamp</small>
                    </p>

                    @if (routeId != null)
                    {
                        <h3>Comments</h3>

                        @if (Model.Comments.Any())
                        {
                            <ul>
                                @foreach (var comment in Model.Comments)
                                {
                                    <li>
                                        <strong>@comment.Author</strong>
                                        @comment.Text
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>No comments yet.</p>
                        }

                        <h3>Proposals</h3>

                        @if (Model.Proposals.Any())
                        {
                            <ul>
                                @foreach (var proposal in Model.Proposals)
                                {
                                    <li>
                                        <strong>@proposal.Author</strong>
                                        @proposal.Text
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>No proposals yet.</p>
                        }
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
</div>
