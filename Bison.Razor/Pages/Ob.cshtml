@page "/ob/{id?}"
@model Bison.Razor.Pages.ObModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var routeId = HttpContext.GetRouteValue("id");
}

<div>
    @if (routeId != null)
    {
        <h2>Observation with ID: @routeId</h2>
    }
    else
    {
        <h2>All Observations</h2>
    }

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@obs.Author">@obs.Author</a>
                        </strong>
                        @obs.Text
                        <small>&mdash; @obs.Timestamp</small>
                        @if (obs.ImageData != null && !string.IsNullOrEmpty(obs.ImageContentType))
                        {
                            <img src="data:@obs.ImageContentType;base64,@Convert.ToBase64String(obs.ImageData)"
                                alt="Observation picture"
                                style="max-width: 40px; max-height: 40px;" />
                        }
                    </p>

                    @if (routeId != null)
                    {
                        <h3>Comments</h3>

                        @if (Model.Comments.Any())
                        {
                            <ul>
                                @foreach (var comment in Model.Comments)
                                {
                                    <li>
                                        <strong>@comment.Author</strong>
                                        @comment.Text
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>No comments yet.</p>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form method="post" asp-page-handler="Comment">
                                <input type="hidden" name="observationId" value="@routeId" />

                                <textarea name="text"
                                        maxlength="2000"
                                        required
                                        placeholder="Write a comment..."></textarea>

                                <button type="submit">Add Comment</button>
                            </form>
                        }

                        <h3>Proposals</h3>

                        @if (Model.Proposals.Any())
                        {
                            <ul>
                                @foreach (var proposal in Model.Proposals)
                                {
                                    <li>
                                        <strong>@proposal.Author</strong>
                                        @proposal.Text
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>No proposals yet.</p>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form method="post" asp-page-handler="Proposal">
                                <input type="hidden" name="observationId" value="@routeId" />

                                <textarea name="text"
                                        maxlength="2000"
                                        required
                                        placeholder="Explain your proposal..."></textarea>

                                <input type="number"
                                    name="taxonId"
                                    required
                                    placeholder="Taxon ID" />

                                <button type="submit">Add Proposal</button>
                            </form>
                        }
                    }
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
</div>
