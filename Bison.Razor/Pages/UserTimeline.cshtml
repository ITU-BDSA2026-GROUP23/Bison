@page "/{author?}"
@model Bison.Razor.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("author");
}

<div>
    @if (routeName != null)
    {
        <h2> @routeName's Observations </h2>
    }
    else
    {
        <h2>All Observations</h2>
    }

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@ob.Author">@ob.Author</a>
                        </strong>
                        @ob.Text
                        <small>&mdash; @ob.Timestamp</small>
                        @if (ob.ImageData != null && !string.IsNullOrEmpty(ob.ImageContentType))
                        {
                            <img src="data:@ob.ImageContentType;base64,@Convert.ToBase64String(ob.ImageData)"
                                alt="Observation picture"
                                style="max-width: 40px; max-height: 40px;" />
                        }
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no Observations so far.</em>
    }
</div>
